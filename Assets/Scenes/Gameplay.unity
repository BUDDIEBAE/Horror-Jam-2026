  currentDay: 1
  currentState: 0
  spawnPoint: {fileID: 834861647}
  day3AwakeningPoint: {fileID: 0}
  days:
  - dayNumber: 1
    dayTitle: 'OPERATION: RECOVERY PROTOCOL'
    briefingTranscript: 'STATION LOG // DAY 01:

      Derelict cargo module adrift
      at coordinates 142.8 MHz. Retrieve flight recorder telemetry and return to
      airlock before life support depletes.'
    completionDebriefing: 'EXPEDITION COMPLETE // DAY 01

      DATA LOG TRANSFERRED
      TO SHIP COMPUTER.

      LIFE SUPPORT RESERVES REFILLED.'
    missions:
    - directiveText: Repair Broken Signal Beacon
      frequencyMHz: 142.8
      beaconTag: Signal Beacon I
      targetInteractable: {fileID: 638615887}
      targetBeacon: {fileID: 638615888}
    - directiveText: Repair Broken Signal Beacon
      frequencyMHz: 142.8
      beaconTag: Signal Beacon II
      targetInteractable: {fileID: 1867634616}
      targetBeacon: {fileID: 1867634615}
    customAwakeningPoint: {fileID: 0}
  - dayNumber: 2
    dayTitle: 'OPERATION: AUXILIARY LIFE SUPPORT'
    briefingTranscript: 'COMMAND DISPATCH // DAY 02:

      Sub-station O2 pressure
      drop detected across Sector 2. Locate backup depot at 156.8 MHz, initiate manual
      recharge, and secure the supply.'
    completionDebriefing: 'EXPEDITION COMPLETE // DAY 02

      O2 DEPOT INTEGRITY
      RESTORED.'
    missions:
    - directiveText: REPAIR AUXILIARY O2 SUB-STATION I
      frequencyMHz: 154.8
      beaconTag: O2-STATION
      targetInteractable: {fileID: 1990000006}
      targetBeacon: {fileID: 1990000007}
    - directiveText: REPAIR AUXILIARY O2 SUB-STATION II
      frequencyMHz: 154.8
      beaconTag: O2-STATION
      targetInteractable: {fileID: 1153695781}
      targetBeacon: {fileID: 1153695780}
    customAwakeningPoint: {fileID: 0}
  - dayNumber: 3
    dayTitle: 'OPERATION: LUMINOUS SPECTRA'
    briefingTranscript: 'COMMAND DISPATCH // DAY 03:

      #@$%@@ AS#@$%@@ F #@$%@@
      G #@$%@@#@$%@@'
    completionDebriefing: 'EXPEDITION COMPLETE // DAY 03

      PREPARE FOR RETURNING
      TO #@$%@@'
    missions:
    - directiveText: INVESTIGATE LUMINOUS ANOMALY
      frequencyMHz: 166.6
      beaconTag: ANOMALY
      targetInteractable: {fileID: 223220110}
      targetBeacon: {fileID: 223220112}
    - directiveText: INVESTIGATE LUMINOUS ANOMALY
      frequencyMHz: 166.6
      beaconTag: ANOMALY
      targetInteractable: {fileID: 645302199}
      targetBeacon: {fileID: 645302198}
    - directiveText: INVESTIGATE LUMINOUS ANOMALY
      frequencyMHz: 166.6
      beaconTag: ANOMALY
      targetInteractable: {fileID: 309679566}
      targetBeacon: {fileID: 309679565}
    - directiveText: INVESTIGATE LUMINOUS ANOMALY
      frequencyMHz: 166.6
      beaconTag: ANOMALY
      targetInteractable: {fileID: 430342284}
      targetBeacon: {fileID: 430342282}
    customAwakeningPoint: {fileID: 0}
  - dayNumber: 4
    dayTitle: THE RETURNING
    briefingTranscript: 'COMMAND DISPATCH // DAY 03:

      RETURN TO #@%$'
    completionDebriefing: 
    missions:
    - directiveText: PRESS LAUNCH BUTTON
      frequencyMHz: 0
      beaconTag: 
      targetInteractable: {fileID: 1287722764}
